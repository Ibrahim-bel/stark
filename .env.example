# =============================================================================
# STARK — Exemple de configuration
#
#   cp .env.example .env
#
#   Minimum requis : le bloc « LLM principal », le bloc « Embeddings »
#   et INPUT_DIR. Tout le reste a des valeurs par défaut utilisables.
#
#   Une variable commentée = non définie : le code applique alors son défaut.
#   Ne mettez pas de commentaire en fin de ligne, il serait lu comme la valeur.
# =============================================================================


# ── LLM principal (génération des questions et des réponses) ──────────────────
# Tout endpoint compatible OpenAI convient : api.openai.com, Azure OpenAI,
# LiteLLM, vLLM, Ollama…
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Défaut du code : gpt-4o-mini
OPENAI_MODEL=gpt-4o
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

# Vérification du certificat TLS.
# Mettre à false uniquement derrière un proxy d'entreprise à certificat auto-signé.
OPENAI_VERIFY_SSL=true

# Hôtes à exclure du proxy HTTP (liste séparée par des virgules).
# Utile quand un proxy intercepte le trafic vers un endpoint LLM interne.
#no_proxy=
#NO_PROXY=


# ── Modèle de scoring QA ──────────────────────────────────────────────────────
# ATTENTION : doit supporter logprobs=True — modèles GPT uniquement.
# Ni Claude ni la plupart des modèles open-source ne renvoient de logprobs.
SCORING_MODEL=gpt-4.1-mini

# Modèle utilisé pour la réponse « sans contexte » (baseline de comparaison).
#HAIKU_MODEL=


# ── Embeddings (relations sémantiques du graphe de connaissances) ─────────────
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
# Défaut du code : text-embedding-ada-002
EMBEDDING_MODEL=text-embedding-3-small


# ── Chemins ───────────────────────────────────────────────────────────────────
# INPUT_DIR  : répertoire du corpus source (parcouru récursivement).
# OUTPUT_DIR : destination du dataset (BEIR + CSV), du KG et des checkpoints.
INPUT_DIR=./docs
OUTPUT_DIR=./src/output/my_run

# Cache disque des graphes construits : évite de recalculer les embeddings
# d'un run à l'autre sur le même corpus.
STARK_KG_STORE_DIR=./kg_store


# ── Génération ────────────────────────────────────────────────────────────────
NUM_QUESTIONS=50

# Défaut des deux suivantes : la valeur de NUM_QUESTIONS.
#GLOBAL_NUM_QUESTIONS=
#PER_DOC_NUM_QUESTIONS=

# Questions sur l'ensemble du corpus.
GENERATE_GLOBAL_QUESTIONS=true
# Questions générées document par document.
GENERATE_PER_DOC_QUESTIONS=false
# Réutiliser le KG global en mode par-document.
PER_DOC_USE_GLOBAL_KG=false

# batch | single
PROCESS_MODE=batch


# ── Chunking ──────────────────────────────────────────────────────────────────
MIN_CHUNK_TOKENS=300
MAX_CHUNK_TOKENS=4096
# Keyphrases extraites par chunk.
MAX_KEYPHRASES=10


# ── Enrichissement du graphe ──────────────────────────────────────────────────
# Active les agents LLM du KG : validation des relations existantes et
# découverte de relations inter-documents.
# Coûteux en tokens, mais produit des questions nettement plus discriminantes.
USE_KG_AGENT=false


# ── Formats de sortie ─────────────────────────────────────────────────────────
# corpus.jsonl + queries.jsonl + qrels.jsonl
GENERATE_BEIR_FORMAT=true
# dataset.csv, pour inspection humaine
GENERATE_CSV=true
# knowledge_graph.json
SAVE_KNOWLEDGE_GRAPH=true


# ── Docling Serve (conversion PDF/DOCX/PPTX/… → Markdown) ─────────────────────
# Service HTTP appelé en début de job : tout document non-Markdown est converti
# en Markdown structuré avant d'entrer dans le pipeline.
# Laisser commenté pour désactiver et n'ingérer que des fichiers texte.
#DOCLING_SERVE_URL=http://localhost:5001
#DOCLING_API_KEY=
# Timeout en secondes.
DOCLING_TIMEOUT=600
DOCLING_PDF_BACKEND=dlparse_v4
# accurate | fast
DOCLING_TABLE_MODE=accurate

# OCR — nécessaire uniquement pour les PDF scannés (image sans couche texte).
DOCLING_OCR_ENABLED=false
DOCLING_OCR_ENGINE=easyocr
DOCLING_OCR_LANG=en,fr,de,es

# Répertoire des modèles Docling en local (fonctionnement hors ligne).
#DOCLING_ARTIFACTS_PATH=

# Décrire les images rencontrées via un modèle vision.
DESCRIBE_IMAGES=true
# Supprimer les sections ## References / ## Appendix / ## Acknowledgments,
# qui n'apportent que du bruit au graphe de connaissances.
STRIP_REFERENCES=true


# ── VLM (extraction visuelle des PDF à figures) ───────────────────────────────
# Inutile pour un corpus déjà textuel (.md, .rst, .ipynb).
USE_VLM=false
REMOTE_VLM=false
VLM_MODEL=pixtral
VLM_HOST=localhost
VLM_PORT=8000
#VLM_API_KEY=
