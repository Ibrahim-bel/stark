
USE_KG_AGENT=


# VLM Configuration
# Les docs cosapp/cosapp-turbo sont en .md, .rst, .ipynb -> pas besoin du VLM
USE_VLM=
REMOTE_VLM=

VLM_MODEL=
VLM_HOST=
VLM_PORT=
# VLM_API_KEY=

# OpenAI Configuration (LiteLLM proxy Safran)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# Scoring Model — must support logprobs (GPT models only, NOT Claude)
# gpt-4.1-mini confirmed working with logprobs=
SCORING_MODEL=

# Judge Model — LLM utilisé par juge.py (doit supporter les longues sorties CoT)

# Indépendant de OPENAI_MODEL (générateur) et SCORING_MODEL (logprobs)
JUDGE_MODEL=

# Embedding Configuration
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# LLM Settings
LLM_MAX_TOKENS=

# Docling Configuration
# Pas besoin de modèles locaux Docling car on traite du texte (md/rst/ipynb)
#DOCLING_ARTIFACTS_PATH=

# ── Docling Serve (conversion PDF/DOCX/... -> Markdown au début du job) ─────────
# URL du service Docling Serve. Tout document non-.md uploadé est converti en
# Markdown structuré via cette API avant d'entrer dans le pipeline.
DOCLING_SERVE_URL=
DOCLING_API_KEY=
DOCLING_TIMEOUT=
DOCLING_OCR_ENABLED=
DOCLING_OCR_ENGINE=
DOCLING_OCR_LANG=
DOCLING_PDF_BACKEND=
DOCLING_TABLE_MODE=
# Description des images par VLM (true =
DESCRIBE_IMAGES=
# Supprimer ## References, ## Appendix, ## Acknowledgments (réduit le bruit du KG)
STRIP_REFERENCES=

# Question Generation
NUM_QUESTIONS=

# Processing Mode
# batch =
PROCESS_MODE=
#PROCESS_MODE=

# -----------------------------------------------------------------------
# INPUT_DIR : répertoire contenant les docs cosapp + cosapp-turbo
#
# Option A – cosapp-turbo uniquement (markdown structuré, recommandé)
#INPUT_DIR=
#
# Option B – cosapp uniquement (notebooks Jupyter)
#INPUT_DIR=
#
# Option C – les deux sources à la fois (cosapp + cosapp-turbo, tous les .md)
#INPUT_DIR=
# -----------------------------------------------------------------------

# Option A activée : cosapp-turbo uniquement, récursif sur tous les .md
# Docs rapatriés localement pour rendre STARK autonome (plus de dépendance externe)
INPUT_DIR=

# OUTPUT_DIR : où seront sauvegardés le dataset RAGAS, le KG, le CSV, le BEIR
OUTPUT_DIR=

# Output Format Options
GENERATE_BEIR_FORMAT=
GENERATE_CSV=
SAVE_KNOWLEDGE_GRAPH=

# Question Generation Options
GENERATE_GLOBAL_QUESTIONS=
GENERATE_PER_DOC_QUESTIONS=
PER_DOC_USE_GLOBAL_KG=

# ── Evaluation flags ──────────────────────────────────────────────────────────
# Mettre à true pour désactiver le scoring ΔSePer et le LLM-as-a-Judge
# (utile pour générer uniquement les Q/R sans attendre l'évaluation)
SKIP_EVALUATION=

# ── Haiku "no-context" answer ─────────────────────────────────────────────────
# Modèle utilisé pour l'appel séparé "réponse sans contexte"
# (doit être dispo sur le proxy Safran ; claude-haiku est déjà configuré)
HAIKU_MODEL=

# Question Counts
GLOBAL_NUM_QUESTIONS=
PER_DOC_NUM_QUESTIONS=

# Chunk size (tokens) – les fichiers .md cosapp-turbo sont courts, garder des petits chunks
MIN_CHUNK_TOKENS=
MAX_CHUNK_TOKENS=
MAX_KEYPHRASES=
# SSL / Proxy fix — apphub.safran doit bypasser le proxy Squid Safran
# Sans cela, le proxy intercepte HTTPS et le cert auto-signé bloque les requêtes
no_proxy=
NO_PROXY=
# Désactiver la vérification SSL (le cert litellm.dev.apphub.safran est auto-signé)
OPENAI_VERIFY_SSL=
# Graphify SSL — même proxy Safran, cert auto-signé → désactiver la vérification
GRAPHIFY_SSL_VERIFY=
